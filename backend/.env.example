# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by Git — never commit it.

# A long random string. Generate one with:
#   ..\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (see README "Deployment checklist"): True once the site is served over HTTPS.
DJANGO_HTTPS=False

# PostgreSQL database used by the app (created by scripts\setup_db.ps1)
DB_NAME=iodss
DB_USER=iodss
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Address of the React dev server (needed for CSRF protection)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo account created by:  ..\.venv\Scripts\python manage.py create_demo_user
DEMO_USER_EMAIL=demo@iodss.local
DEMO_USER_PASSWORD=change-me
